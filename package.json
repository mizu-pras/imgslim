{
  "name": "imgslim",
  "version": "1.0.3",
  "description": "CLI tool to convert images to WebP, minify PNG images, and scale image dimensions",
  "packageManager": "npm@10.9.0",
  "bin": {
    "imgslim": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "README_id.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node test/imgslim.test.mjs",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "image",
    "webp",
    "optimizer",
    "cli",
    "sharp",
    "compress",
    "convert",
    "resize",
    "scale"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizu-pras/imgslim.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
